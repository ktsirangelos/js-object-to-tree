{
  "name": "js-object-to-tree",
  "version": "2.0.0",
  "description": "A recursive function that receives a JavaScript object and creates a visual tree-like representation of it.",
  "keywords": [
    "tree",
    "object",
    "ascii",
    "tree-view",
    "visualize",
    "console",
    "print",
    "typescript"
  ],
  "homepage": "https://github.com/ktsirangelos/js-object-to-tree#readme",
  "bugs": {
    "url": "https://github.com/ktsirangelos/js-object-to-tree/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktsirangelos/js-object-to-tree.git"
  },
  "license": "MIT",
  "author": "Konstantinos Tsirangelos <ktsirangelos@proton.me>",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/objectToTree.js",
  "types": "./dist/objectToTree.d.ts",
  "exports": {
    ".": {
      "types": "./dist/objectToTree.d.ts",
      "default": "./dist/objectToTree.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "jest": {
    "preset": "ts-jest"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  }
}
